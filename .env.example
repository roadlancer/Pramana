# Google OAuth 2.0 Client ID for Chrome Extension
# Get from: https://console.cloud.google.com/apis/credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional: the Chrome Web Store item's public key (Developer console → Package → View public key),
# so unpacked builds get the same extension ID as the store. Without it, a fixed development key is used.
# VITE_EXTENSION_KEY=
