{
  "manifest_version": 3,
  "name": "Pramana",
  "version": "0.1.0",
  "description": "Capture, edit, store, organize, and share screenshots and recordings — all from your own Google Drive.",
  "permissions": [
    "identity",
    "tabCapture",
    "storage",
    "activeTab",
    "scripting",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "oauth2": {
    "client_id": "SET_BY_scripts/generate-manifest.js_FROM_.env",
    "scopes": ["https://www.googleapis.com/auth/drive.file"]
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "pause-recording": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Pause or resume the recording"
    },
    "stop-recording": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Stop the recording"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
